# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dialog_survey?schema=public"

# LLM Configuration (OpenAI-compatible — works with ollama, vLLM, LocalAI, or cloud)
# LLM_BASE_URL MUST be the full chat completions ENDPOINT URL, not a gateway base:
#   correct:   http://localhost:11434/v1/chat/completions
#   WRONG:     http://localhost:11434/v1   (gateway base -> /health and calls return HTTP 404)
# LLM_BASE_URL=http://localhost:11434/v1/chat/completions
LLM_API_KEY=your-llm-api-key
LLM_MODEL=qwen2.5
# Alternatively, use Volcengine Ark (fallback when LLM_ prefix not set):
# VOLCENGINE_API_KEY=your-volcengine-api-key
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v1/chat/completions
# VOLCENGINE_MODEL=deepseek-v3.2


# DingTalk Configuration
# Credentials may be given as either CLIENT_ID/SECRET or APP_KEY/SECRET
# (both spellings are accepted by REST and Stream alike).
DINGTALK_CLIENT_ID=your-dingtalk-client-id
DINGTALK_CLIENT_SECRET=your-dingtalk-client-secret
DINGTALK_AGENT_ID=your-dingtalk-agent-id
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret
# Name of the bot invitees should reply to. Leave unset to use generic
# wording ("this robot").
# DINGTALK_BOT_NAME=智能访谈

# Security
# @deprecated ENCRYPTION_KEY is no longer used at runtime (only referenced in tests/cli.test.ts)
ENCRYPTION_KEY=your-32-byte-encryption-key-hex
ADMIN_API_KEY=your-admin-api-key

# Report Configuration
# Where exported PDFs and workbooks are written. `./reports` is right for a
# direct install. In Docker this is overridden to /app/reports and backed by the
# `reports_data` volume (issue #216) — exported reports are the deliverable of
# this product, so they must survive `docker compose up --build` and image
# upgrades. Back that volume up together with postgres_data; see DEPLOY.md.
REPORTS_DIR=./reports

# Logging
LOG_LEVEL=info

# Additional LLM Provider Keys (optional — used by specific integrations)
ANTHROPIC_AUTH_TOKEN=your-anthropic-auth-token
DASHSCOPE_API_KEY=your-dashscope-api-key

# Playwright Configuration (for PDF/Excel export)
PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium

# =============================================================================
# ADMIN AUTHENTICATION (Session-based)
# =============================================================================
# Admin user credentials
# Generate password hash: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 12).then(console.log)"
ADMIN_USERNAME=admin
#
# ┌─ DOCKER COMPOSE USERS: DOUBLE EVERY `$` ────────────────────────────────┐
# │ A bcrypt hash looks like  $2b$12$<22 chars><31 chars>.                │
# │ `docker compose` interpolates variables inside `env_file` values, so   │
# │ it reads `$2b` and `$12` as undefined variables and replaces them with │
# │ the empty string. The container then gets a truncated hash that can    │
# │ never match: the admin login returns 401 for a CORRECT password, and   │
# │ nothing in any log points at the cause (issue #214).                   │
# │                                                                        │
# │ Escaped form (correct for `docker compose up`):                        │
# │   ADMIN_PASSWORD_HASH=$$2b$$12$$KIXqQ0H2m9Q0hV0dQ0c0eO8Y2h5k3k5k...   │
# │                                                                        │
# │ A direct install (`npx dialog-survey install`, PM2, `docker run -e`)   │
# │ does NOT interpolate, so it takes the single-`$` form. The two         │
# │ deployments need different literals from the same hash.               │
# └────────────────────────────────────────────────────────────────────────┘
ADMIN_PASSWORD_HASH=

# Session configuration
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Generate salt: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SESSION_SALT=
SESSION_MAX_AGE=28800  # 8 hours in seconds

# =============================================================================
# METRICS (Prometheus, /metrics endpoint)
# =============================================================================
# Optional bearer token; leave empty to allow unauthenticated scrapes (LAN only)
METRICS_TOKEN=
