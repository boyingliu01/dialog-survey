# Ops watchdog configuration — copy to ~/.config/dialog-survey-ops.env (chmod 600)
# or /etc/default/dialog-survey-ops (read by systemd units).
# Every value below is a default that the scripts already fall back to; list only
# what differs on your host. No secrets belong in this file — the DingTalk
# credentials stay in the deployment .env that the app itself uses.

# --- containers / endpoints -------------------------------------------------------
DS_APP=dialog-survey-app
DS_DB=dialog-survey-db
DS_DB_NAME=dialog_survey
DS_DB_USER=dialog_survey
DS_NETWORK=dialog-survey-src_default
DS_BASE_URL=http://127.0.0.1:3001
DS_HEALTH_URL=http://127.0.0.1:3001/health
DS_APP_PORT=3001

# --- alert delivery (ds-alert.sh) -------------------------------------------------
# The app .env provides DINGTALK_CLIENT_ID / DINGTALK_CLIENT_SECRET / DINGTALK_AGENT_ID.
DS_ENV_FILE=/opt/dialog-survey/.env
# Required: comma-separated DingTalk userIds that receive work notifications.
ALERT_USERIDS=
# Optional group-robot webhook; preferred by the Windows-side watchdog because it
# still works when WSL is completely down.
ALERT_WEBHOOK=
DS_ALERT_IMAGE=dialog-survey:local-build

# --- alerting behaviour (ds-health-watch.sh) --------------------------------------
# /health calls the LLM gateway live, so one slow probe is not an outage.
DS_FAIL_THRESHOLD=2
DS_HEALTH_TIMEOUT=40
DS_REALERT_SECONDS=1800

# --- backup / restore drill -------------------------------------------------------
DS_BACKUP_DIR=/var/backups/dialog-survey
DS_BACKUP_KEEP=14
# Second copy outside the WSL virtual disk; leave empty to skip.
DS_OFFSITE_DIR=
DS_PG_IMAGE=postgres:16-alpine
# Space-separated table names the drill must be able to read.
DS_CORE_TABLES=Interview InterviewPlan Template AnalysisReport Message Response

# --- logging / state --------------------------------------------------------------
DS_STATE_DIR=/var/lib/dialog-survey-ops
DS_ALERT_LOG=/var/log/dialog-survey-alert.log
DS_WATCH_LOG=/var/log/dialog-survey-health-watch.log
DS_BACKUP_LOG=/var/log/dialog-survey-backup.log
DS_DRILL_LOG=/var/log/dialog-survey-drill.log
DS_REPAIR_LOG=/var/log/dialog-survey-net-repair.log
